<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd"
                   logicalFilePath="changelog.xml"> <!-- this is important, it ensures that migrations run from the command line
                                                         and those that run on spring startup have the same identifier in the databasechangelog table;
                                                         if absent then migrations might be run twice -->

    <changeSet id="1" author="radu" dbms="PostgreSQL">
        <sqlFile path="sql/00000-init.sql" relativeToChangelogFile="true"/>
    </changeSet>


</databaseChangeLog>
